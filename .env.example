# OKX CEX API key with Read + Trade only; do not enable Withdraw. Restrict by IP.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Onchain OS read-only quote credentials
OKX_DEX_API_KEY=
OKX_DEX_API_SECRET=
OKX_DEX_API_PASSPHRASE=

# Dedicated, low-balance wallets. Keep these out of config.yaml, logs, and chat.
# X Layer accepts a 0x-prefixed EVM private key. Solana accepts base58 or a JSON byte array.
XLAYER_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=
# Separate wallet used only to sign Solana simulation transactions; never used for broadcast/execution.
SOLANA_SIMULATION_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com

# Optional per-pool Solana endpoint pairs. Set both values and uncomment the
# matching rpc_http/rpc_ws entries for that pool in market-registry.yaml.
# Use HTTP and WSS endpoints from the same provider; otherwise the pool can
# observe updates and snapshots at different slots.
# SOLANA_XSPCX_RAYDIUM_RPC_HTTP=
# SOLANA_XSPCX_RAYDIUM_RPC_WS=
# SOLANA_XSPCX_ORCA_RPC_HTTP=
# SOLANA_XSPCX_ORCA_RPC_WS=
# SOLANA_XSPCX_METEORA_RPC_HTTP=
# SOLANA_XSPCX_METEORA_RPC_WS=
# SOLANA_XSPCX_BYREAL_RPC_HTTP=
# SOLANA_XSPCX_BYREAL_RPC_WS=

# Public read-only endpoints; dedicated RPCs are more reliable for long-running observation.
XLAYER_RPC_HTTP=https://rpc.xlayer.tech
XLAYER_RPC_WS=wss://xlayerws.okx.com

# Verified protocol deployment addresses are pinned in market-registry.yaml.
# Optional deployment-specific observe-only pool allowlist. If set, only these observe-only pools are enabled.
# MARKET_REGISTRY_OBSERVE_POOL_IDS=xspcx-xlayer-wspcxx-usdg-v3
